{
  // Listening reaction for the PC cortex after its wake word. First the stock "hey vector" gesture: the wake
  // word earcon and get-in (head up), then the stock turn toward the voice (ReactToTriggerDirectionAwake: no
  // turn on the charger, when picked up, or for voices from 11, 12 and 1 o'clock), then the head up at the
  // get-in's angle and a silent eye pose held, in the listening eye color, until the next user intent (the
  // answer, left pending for its own behavior), cortex_listening_end (a short give-up gesture first), or the
  // safety timeout. cortex_listening_prompt shows a question mark above the eyes and keeps listening. The
  // user's eye color comes back on every exit. Deliberately no postBehaviorSuggestion: HighLevelAI resumes
  // its previous state.
  "behaviorID": "CortexListening",
  "behaviorClass": "CortexListening",

  "associatedActiveFeature": "BasicVoiceCommand",

  "respondToUserIntents": [
    { "type": "cortex_listening" },
    { "type": "cortex_listening_end" },
    { "type": "cortex_listening_prompt" }
  ],
  "showActiveIntentFeedback": false,

  // empty strings disable the earcon, the get-in or the turn
  "earConAudioEvent": "Play__Robot_Vic_Sfx__Wake_Word_On",
  "getInAnimTrigger": "VC_ListeningGetIn",
  "turnBehavior": "ReactToTriggerDirectionAwake",
  // dominant mic direction over this window before the wake intent arrived, ignoring low confidence samples
  "directionWindow_s": 2.0,
  "minDirectionConfidence": 500,
  "headAngle_deg": 33.0,

  // listening eye color (UNCANNY_YELLOW), not saved as the eye color setting
  "eyeHue": 0.11,
  "eyeSaturation": 1.0,
  // empty strings disable the question mark or the give-up gesture
  "promptSpriteName": "cortex_question_mark",
  "promptDuration_s": 3.0,
  "giveUpAnimName": "anim_wakeword_idk_01",

  "animName": "anim_eyepose_curious",
  // safety net only: the PC ends listening (prompt ~6 s after the wake, give-up ~9 s)
  "timeout_s": 15.0
}
